# ─────────────────────────────────────────────────────────────────────────
#  LexScout — Environment Variables Template
#  Copy this file to .env and fill in your values:
#      Windows:  copy env.example .env
#      Mac/Linux: cp env.example .env
# ─────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────
# Google AI Studio key — free tier works for development.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────
# Set to "development" to enable auto-reload via uvicorn --reload
ENV=production

# Port to bind the server to (Railway / Render inject $PORT automatically)
PORT=8000

# ── Future: Bright Data MCP credentials ──────────────────────────────────
# These will be needed when you wire real MCP calls in Chat 2.
# BRIGHT_DATA_API_TOKEN=your_bright_data_token_here
# BRIGHT_DATA_ZONE_SERP=serp_zone_name
# BRIGHT_DATA_ZONE_UNLOCKER=web_unlocker_zone_name
# BRIGHT_DATA_ZONE_SCRAPING=scraping_browser_zone_name
# BRIGHT_DATA_ZONE_AUTOMATION=browser_automation_zone_name
